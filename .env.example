# Server: copy this file to .env and replace every placeholder. Never commit .env.
NODE_ENV=production
PORT=3000
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/fadil_trading?retryWrites=true&w=majority
JWT_SECRET=replace_this_with_a_long_random_secret
CLIENT_URL=https://your-domain.example
# Sections are intentionally unavailable to students until explicitly enabled.
PUBLIC_NEWS_ENABLED=true
PUBLIC_QUIZZES_ENABLED=false
# Optional: use a different complete JSON file for questions and quizzes.
QUIZZES_FILE=data/quizzes.json
# Change these after the first login in production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
